{
  "name": "bangkok-district-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile-first production-ready web application to track visits and explored places across all 50 districts of Bangkok on an interactive map.",
  "scripts": {
    "setup": "bun run scripts/setup.ts",
    "dev": "next dev",
    "prebuild": "bun run scripts/prebuild.ts",
    "build": "bun run scripts/prebuild.ts && next build",
    "start": "next start",
    "lint": "next lint",
    "bun:dev": "bun --bun next dev",
    "bun:build": "bun --bun next build",
    "bun:start": "bun --bun next start",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run scripts/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "lucide-react": "^0.453.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "swr": "^2.5.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
